# Server
PORT=3000
NODE_ENV=development
APP_URL=http://localhost:3000
LOG_LEVEL=info

# Security & Auth
SESSION_SECRET=
SETTINGS_PASSWORD=

# Database (optional — falls back to in-memory mock if unset)
