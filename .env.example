# AI (Gemini)
GEMINI_API_KEY=

# Optional OAuth Credentials (can also be configured in Settings UI)
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
